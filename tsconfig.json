{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@pwacn/react": [
        "./vendor/pwacn-react/src/index.ts"
      ],
      "@pwacn/core": [
        "./vendor/pwacn-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vendor"
  ]
}